    "framer-motion": "^12.40.0",
    "imapflow": "^1.4.0",
    "lucide-react": "^1.17.0",
    "mailparser": "^3.9.9",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.5.0",
    "resend": "^6.12.4",
